# =============================================================================
# diginachlass.ch — Umgebungskonfiguration (Vorlage)
# Kopieren nach .env und Werte eintragen. NIEMALS echte Secrets committen!
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=3000
APP_BASE_URL=https://app.diginachlass.ch   # öffentliche Basis-URL (für Links/Redirects)

# Hinter einem Reverse-Proxy (TLS-Terminierung) auf true setzen,
# damit secure-Cookies und req.ip korrekt funktionieren.
TRUST_PROXY=false

# --- Datenbank (PostgreSQL, Standort Schweiz) --------------------------------
# Verschlüsselung at rest auf DB/Festplatte voraussetzen; Verbindung via TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/diginachlass?sslmode=require

# --- Sicherheit --------------------------------------------------------------
# Lange Zufallswerte, z. B.:  openssl rand -hex 32
SESSION_SECRET=[langer-zufaelliger-wert-min-32-zeichen]
ENCRYPTION_KEY=[langer-zufaelliger-wert-min-32-zeichen]   # verschlüsselt TOTP-Secrets

# --- SMTP (z. B. Infomaniak) -------------------------------------------------
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465                        # 465 = TLS, 587 = STARTTLS
SMTP_USER=no-reply@diginachlass.ch
SMTP_PASS=[smtp-passwort]
SMTP_FROM=diginachlass.ch <no-reply@diginachlass.ch>

# --- Stripe (NUR Test-Modus während der Entwicklung) ------------------------
# Live-Keys setzt der Betreiber selbst in der Produktions-ENV.
STRIPE_SECRET_KEY=sk_test_[...]
STRIPE_PUBLISHABLE_KEY=pk_test_[...]
STRIPE_WEBHOOK_SECRET=whsec_[...]    # aus `stripe listen` oder Dashboard-Webhook

# Price-IDs aus dem Stripe-Dashboard (Test-Modus). Beträge in CHF werden direkt
# am Stripe-Price-Objekt gesetzt — Richtwerte:
STRIPE_PRICE_MONTHLY=[Price-ID monatliches Abo]    # ~ CHF 4.90 / Monat
STRIPE_PRICE_YEARLY=[Price-ID jährliches Abo]      # ~ CHF 49.00 / Jahr
STRIPE_PRICE_LIFETIME=[Price-ID Einmalzahlung]     # ~ CHF 99.00 einmalig (lifetime)
